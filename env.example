# Copy to .env and edit. Every value is optional; defaults are in docker-compose.yml.
# .env is gitignored. Never commit real credentials.

# ── Host folders ─────────────────────────────────────────────────────────────
# Notebooks folder mounted into the container (use an absolute path or ./relative)
WORK_DIR=./notebooks
# Folder holding the input CSVs (flights_*.csv, airports.csv, carriers.csv, plane_types.csv)
DATA_DIR=./data

# ── Jupyter ──────────────────────────────────────────────────────────────────
# Empty = no authentication (fine on localhost only). Set a token if the port is
# reachable from other machines.
JUPYTER_TOKEN=
JUPYTER_HOST_PORT=8888

# ── Spark ────────────────────────────────────────────────────────────────────
SPARK_DRIVER_MEMORY=2g

# ── MinIO / S3 (local development credentials) ───────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
AWS_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ICEBERG_REST_PORT=8181

# ── Build-time versions (change, then `make build`) ──────────────────────────
NB_USER=spark
SPARK_VERSION=4.1.2
ICEBERG_VERSION=1.12.0
